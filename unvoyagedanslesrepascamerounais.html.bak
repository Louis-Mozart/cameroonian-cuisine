<html><head><meta content="text/html; charset=UTF-8" http-equiv="content-type"><style type="text/css">@import url(https://themes.googleusercontent.com/fonts/css?kit=NlxxF474I3n8-R73Aorllw);ol{margin:0;padding:0}table td,table th{padding:0}.c24{color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:24pt;font-family:"Arial";font-style:normal}.c6{color:#274e13;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:"Arial";font-style:italic}.c5{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:"Arial";font-style:normal}.c11{color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:15pt;font-family:"Arial";font-style:normal}.c33{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:"Arial";font-style:normal}.c2{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:"Arial";font-style:italic}.c23{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:"Arial";font-style:italic}.c16{color:#274e13;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:18pt;font-family:"Arial";font-style:normal}.c18{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:26pt;font-family:"Arial";font-style:normal}.c4{color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:"Arial";font-style:italic}.c28{color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:"Arial";font-style:normal}.c29{color:#274e13;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:"Arial";font-style:italic}.c13{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:12pt;font-family:"Arial";font-style:italic}.c19{color:#274e13;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:30pt;font-family:"Arial";font-style:normal}.c15{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:24pt;font-family:"Arial";font-style:normal}.c0{color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:14pt;font-family:"Arial";font-style:normal}.c8{color:#000000;font-weight:700;text-decoration:none;vertical-align:baseline;font-size:28pt;font-family:"Arial";font-style:normal}.c1{padding-top:0pt;padding-bottom:0pt;line-height:1.15;orphans:2;widows:2;text-align:left}.c17{padding-top:0pt;padding-bottom:0pt;line-height:1.15;orphans:2;widows:2;text-align:right}.c12{padding-top:0pt;padding-bottom:0pt;line-height:1.15;orphans:2;widows:2;text-align:center}.c21{color:#38761d;font-weight:400;text-decoration:none;vertical-align:baseline;font-family:"Arial"}.c22{color:#274e13;text-decoration:none;vertical-align:baseline;font-family:"Arial";font-style:normal}.c31{color:#274e13;font-weight:400;text-decoration:none;vertical-align:baseline;font-family:"Arial"}.c9{font-size:12pt;font-style:italic;color:#274e13;font-weight:700}.c25{font-size:13pt;font-style:italic;color:#274e13;font-weight:700}.c38{color:#000000;font-weight:700;font-size:15pt;font-style:normal}.c40{color:#000000;font-weight:700;font-size:29pt;font-style:italic}.c42{color:#000000;font-weight:700;font-size:20pt;font-style:normal}.c43{color:#000000;font-weight:400;font-size:18pt;font-style:italic}.c10{background-color:#ffffff;max-width:468pt;padding:72pt 72pt 72pt 72pt}.c30{color:#274e13;font-size:30pt;font-weight:700}.c37{font-size:19pt;font-weight:700;font-style:italic}.c7{font-size:14pt;font-weight:700;font-style:italic}.c27{font-size:12pt;font-weight:700;font-style:italic}.c41{color:#ff9900;font-size:30pt;font-weight:700}.c35{text-decoration:none;vertical-align:baseline;font-family:"Arial"}.c36{color:#274e13;font-size:12pt;font-style:italic}.c14{font-size:14pt;font-weight:700}.c44{font-family:"Lobster";color:#274e13}.c20{font-size:14pt;font-style:italic}.c34{font-size:28pt;font-weight:700}.c26{font-size:24pt;font-weight:700}.c39{margin-left:36pt}.c32{font-size:14pt}.c3{height:11pt}.c45{color:#274e13}.title{padding-top:0pt;color:#000000;font-size:26pt;padding-bottom:3pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}.subtitle{padding-top:0pt;color:#666666;font-size:15pt;padding-bottom:16pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}li{color:#000000;font-size:11pt;font-family:"Arial"}p{margin:0;color:#000000;font-size:11pt;font-family:"Arial"}h1{padding-top:20pt;color:#000000;font-size:20pt;padding-bottom:6pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}h2{padding-top:18pt;color:#000000;font-size:16pt;padding-bottom:6pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}h3{padding-top:16pt;color:#434343;font-size:14pt;padding-bottom:4pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}h4{padding-top:14pt;color:#666666;font-size:12pt;padding-bottom:4pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}h5{padding-top:12pt;color:#666666;font-size:11pt;padding-bottom:4pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;orphans:2;widows:2;text-align:left}h6{padding-top:12pt;color:#666666;font-size:11pt;padding-bottom:4pt;font-family:"Arial";line-height:1.15;page-break-after:avoid;font-style:italic;orphans:2;widows:2;text-align:left}</style></head><body class="c10 doc-content"><p class="c12"><span class="c30">Un </span><span class="c41">voyage </span><span class="c19">dans les repas camerounais</span></p><p class="c12 c3"><span class="c2"></span></p><p class="c12"><span class="c7">16 </span><span class="c23">recettes camerounaises faciles, m&ecirc;me loin du pays</span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c12 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1 c3"><span class="c16"></span></p><p class="c12"><span class="c37">Par </span><span class="c7 c44">T</span><span class="c7 c45">&eacute;claire write</span><hr style="page-break-before:always;display:none;"></p><p class="c1"><span class="c16">Bienvenue</span></p><p class="c1 c3"><span class="c16"></span></p><p class="c1"><span class="c0">Bienvenue dans Un voyage dans les repas camerounais.</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c0">&Agrave; travers cet ebook, je vous invite &agrave; d&eacute;couvrir les saveurs authentiques de la cuisine camerounaise, o&ugrave; que vous soyez dans le monde.</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c0">Que vous viviez en Europe, en Afrique ou ailleurs, ces recettes ont &eacute;t&eacute; s&eacute;lectionn&eacute;es pour leur simplicit&eacute; et leur caract&egrave;re traditionnel. Certaines utilisent des ingr&eacute;dients faciles &agrave; trouver hors du Cameroun, afin que chacun puisse retrouver le go&ucirc;t du pays &agrave; sa table.</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c32">Ce livre est destin&eacute; aussi bien aux d&eacute;butants qu&rsquo;aux passionn&eacute;s de cuisine africaine</span><span class="c11">. Chaque recette est expliqu&eacute;e &eacute;tape par &eacute;tape pour vous permettre de cuisiner avec confiance et plaisir.</span></p><p class="c1 c3"><span class="c11"></span></p><p class="c1"><span class="c11">J&rsquo;esp&egrave;re que ce voyage culinaire vous fera d&eacute;couvrir de nouvelles saveurs, ravivera de beaux souvenirs et vous donnera envie de partager ces plats avec vos proches.</span></p><p class="c1 c3"><span class="c11"></span></p><p class="c1"><span class="c35 c38">Bonne lecture et bon app&eacute;tit !</span></p><p class="c1 c3"><span class="c11"></span></p><p class="c17"><span class="c20 c21">T&eacute;claire Writes</span></p><hr style="page-break-before:always;display:none;"><p class="c1 c3"><span class="c24"></span></p><p class="c12"><span class="c24">Sommaire</span></p><p class="c1 c39"><span class="c0">1.Introduction</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.Ndol&eacute;</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.Eru et Water Fufu</span></p><p class="c1"><span class="c0">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;4.Beignets Haricots</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5.Mbongo Tchobi</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;6.Koki</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;7.Poulet DG</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;8.Sauce Pistache et Couscous de Manioc</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;9.Okok</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;10.Couscous de Ma&iuml;s et L&eacute;gumes</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;11.Frites de Plantains M&ucirc;rs et Haricots rouges</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;12.Poisson Brais&eacute; &agrave; la Camerounaise</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;13.Jollof Rice au Poulet</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;14.Taro et Sauce Jaune </span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;15.Pile de Pommes de Terre aux Haricots Rouges ou Noirs </span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;16.Spaghettis Saut&eacute;s &agrave; la Camerounaise</span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;17.Kondre </span></p><p class="c1"><span class="c0">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1 c3"><span class="c0"></span></p><hr style="page-break-before:always;display:none;"><p class="c12 c3"><span class="c15"></span></p><p class="c12"><span class="c15">NDOLE</span></p><p class="c12 c3"><span class="c5"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 307.17px; height: 330.19px;"><img alt="" src="images/image14.jpg" style="width: 307.17px; height: 330.19px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c5">Description</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Le ndol&eacute; est l&rsquo;un des plats les plus c&eacute;l&egrave;bres du Cameroun. Originaire du peuple Sawa, il est aujourd&rsquo;hui appr&eacute;ci&eacute; dans tout le pays et m&ecirc;me &agrave; l&rsquo;international. Pr&eacute;par&eacute; &agrave; base de feuilles de ndol&eacute;, d&rsquo;arachides et de viande ou de poisson, ce plat offre un m&eacute;lange unique de saveurs qui fait la fiert&eacute; de la cuisine camerounaise.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c5">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">&#9201;&#65039; 1 h 30 min</span></p><p class="c1"><span class="c20">Pour&#128101;</span><span class="c14">&nbsp;</span><span class="c7">4 personnes</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c5">Ingr&eacute;dients</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500 g de feuilles de ndol&eacute;</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;300 g de viande de b&oelig;uf</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 g de crevettes</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 g de poisson fum&eacute;</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;150 g de p&acirc;te d&rsquo;arachide</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 gros oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 gousses d&rsquo;ail</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 cuill&egrave;res &agrave; soupe d&rsquo;huile v&eacute;g&eacute;tale</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c5">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c5">&Eacute;tape 1 : Pr&eacute;parer les feuilles</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c20">Laver soigneusement les feuilles de </span><span class="c20">ndol&eacute;</span><span class="c4">&nbsp;puis les faire bouillir pendant quelques minutes afin de r&eacute;duire leur amertume. &Eacute;goutter et r&eacute;server.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la viande</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Faire cuire la viande avec l&rsquo;oignon, l&rsquo;ail, le sel et le poivre jusqu&rsquo;&agrave; ce qu&rsquo;elle soit tendre.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Ajouter le poisson et les crevettes</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Incorporer le poisson fum&eacute; et les crevettes &agrave; la viande puis laisser cuire quelques minutes.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Pr&eacute;parer la sauce</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">D&eacute;layer la p&acirc;te d&rsquo;arachide dans un peu d&rsquo;eau et l&rsquo;ajouter &agrave; la pr&eacute;paration. M&eacute;langer soigneusement.</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c5">&Eacute;tape 5 : Finaliser le ndol&eacute;</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c20">Ajouter les feuilles de </span><span class="c20">ndol&eacute;</span><span class="c4">&nbsp;puis laisser mijoter &agrave; feu doux pendant environ 30 minutes. Ajouter l&rsquo;huile et ajuster l&rsquo;assaisonnement selon votre go&ucirc;t.</span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1 c3"><span class="c0"></span></p><p class="c1"><span class="c2">Accompagnements recommand&eacute;s</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Plantains m&ucirc;rs frits</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Miondo</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Bobolo</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Riz blanc</span></p><p class="c1 c3"><span class="c31 c20"></span></p><p class="c17"><span class="c36">Astuce </span><span class="c9">T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><hr style="page-break-before:always;display:none;"><p class="c1 c3"><span class="c5"></span></p><p class="c12"><span class="c15">ERU ET WATER FUFU</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 279.00px; height: 304.55px;"><img alt="" src="images/image7.jpg" style="width: 279.00px; height: 304.55px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c5">Description</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c4">Originaire principalement du Sud-Ouest du Cameroun, l&rsquo;eru est un plat traditionnel appr&eacute;ci&eacute; dans tout le pays. Associ&eacute; au water fufu, il est r&eacute;put&eacute; pour sa richesse en saveurs et sa valeur nutritive. Ce mets est souvent servi lors des c&eacute;r&eacute;monies familiales et des grandes occasions.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c5">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c14">&#9201;&#65039;</span><span class="c20">&nbsp;1 h 45 min</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pour&#128101; 4 &agrave; 6 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c5">Ingr&eacute;dients</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pour l&rsquo;eru</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de feuilles d&rsquo;eru &eacute;minc&eacute;es</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 kg de waterleaf</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;300 g de viande de b&oelig;uf</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 g de poisson fum&eacute;</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 ml d&rsquo;huile de palme</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 cubes d&rsquo;assaisonnement</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel selon le go&ucirc;t</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pour le water fufu</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de farine de manioc ferment&eacute;e</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c5">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer les ingr&eacute;dients</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Laver soigneusement les feuilles d&rsquo;eru et la waterleaf.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Cuire la viande</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Faire cuire la viande avec le sel et les assaisonnements jusqu&rsquo;&agrave; ce qu&rsquo;elle soit tendre.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Ajouter les l&eacute;gumes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Incorporer la waterleaf puis les feuilles d&rsquo;eru.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Ajouter l&rsquo;huile</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Verser l&rsquo;huile de palme et m&eacute;langer d&eacute;licatement.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 5 : Laisser mijoter</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c20">Laisser cuire &agrave; feu doux pendant environ 20 minutes.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c5">Pr&eacute;paration du Water Fufu</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c32">M&eacute;langer </span><span class="c4">progressivement la farine de manioc avec de l&rsquo;eau.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire cuire &agrave; feu moyen en remuant constamment.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Continuer jusqu&rsquo;&agrave; obtenir une p&acirc;te lisse et homog&egrave;ne.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c17"><span class="c27">Astuce </span><span class="c6">T&eacute;claire Writes</span></p><p class="c17 c3"><span class="c6"></span></p><hr style="page-break-before:always;display:none;"><p class="c17 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c12"><span class="c15">BEIGNETS HARICOTS</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 268.00px; height: 309.66px;"><img alt="" src="images/image3.jpg" style="width: 268.00px; height: 309.66px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c5">Description</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c4">Le beignet haricots est l&rsquo;un des petits-d&eacute;jeuners les plus appr&eacute;ci&eacute;s au Cameroun. Vendu dans les rues, les &eacute;coles et les march&eacute;s, il accompagne le quotidien de nombreuses familles. Ce repas simple et &eacute;conomique est appr&eacute;ci&eacute; pour son go&ucirc;t savoureux et son c&ocirc;t&eacute; nourrissant.</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c5">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c14">&#9201;&#65039; </span><span class="c7">1 </span><span class="c4">h 15 min</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Pour&#128101; 4 personnes</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c5">Ingr&eacute;dients</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Pour les beignets</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500 g de farine de bl&eacute;</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 sachet de levure boulang&egrave;re</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;50 g de sucre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 pinc&eacute;e de sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau ti&egrave;de</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Huile de friture</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Pour les haricots</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500 g de haricots rouges ou blancs</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 cuill&egrave;res &agrave; soupe d&rsquo;huile</span></p><p class="c1"><span class="c4">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&bull; &nbsp; &nbsp; &nbsp; Sel</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c5">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer les haricots</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Trier et laver les haricots.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les faire cuire jusqu&rsquo;&agrave; ce qu&rsquo;ils deviennent tendres.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter l&rsquo;oignon &eacute;minc&eacute;, l&rsquo;huile et le sel.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer et laisser mijoter quelques minutes.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la p&acirc;te &agrave; beignets</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer la farine, la levure, le sucre et le sel.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter progressivement l&rsquo;eau ti&egrave;de jusqu&rsquo;&agrave; obtenir une p&acirc;te souple.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Couvrir et laisser reposer environ 1 heure.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Frire les beignets</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire chauffer l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Pr&eacute;lever de petites portions de p&acirc;te.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire frire jusqu&rsquo;&agrave; obtenir une belle couleur dor&eacute;e.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&Eacute;goutter sur du papier absorbant.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c5">Pr&eacute;sentation</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Servir les beignets chauds avec les haricots. Vous pouvez accompagner le tout d&rsquo;une tasse de th&eacute; ou de caf&eacute;.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c17"><span class="c20">Astuce </span><span class="c6">T&eacute;claire Writes</span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c12 c3"><span class="c15"></span></p><hr style="page-break-before:always;display:none;"><p class="c12 c3"><span class="c15"></span></p><p class="c12"><span class="c26">MBONGO TCHOB</span><span class="c8">i</span></p><p class="c12 c3"><span class="c8"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 261.50px; height: 302.70px;"><img alt="" src="images/image13.jpg" style="width: 261.50px; height: 302.70px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c12 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c5"></span></p><p class="c1"><span class="c5">Description</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1"><span class="c4">Le Mbongo Tchobi est un plat traditionnel du peuple Bassa. Reconnaissable &agrave; sa couleur noire caract&eacute;ristique, il est pr&eacute;par&eacute; &agrave; partir d&rsquo;un m&eacute;lange d&rsquo;&eacute;pices soigneusement grill&eacute;es. Son go&ucirc;t intense et parfum&eacute; en fait l&rsquo;un des plats les plus embl&eacute;matiques de la gastronomie camerounaise.</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1"><span class="c14">Temps </span><span class="c2">de pr&eacute;paration</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1"><span class="c9">&#9201;&#65039;</span><span class="c4">&nbsp;1 h 20 min</span></p><p class="c1"><span class="c4">Pour&#128101; 4 personnes</span></p><p class="c1 c3"><span class="c35 c43"></span></p><p class="c1"><span class="c5">Ingr&eacute;dients</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 poisson frais (carpe, capitaine ou tilapia)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 tomates</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 gousses d&rsquo;ail</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3 cuill&egrave;res &agrave; soupe d&rsquo;&eacute;pices Mbongo Tchobi</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 cuill&egrave;res &agrave; soupe d&rsquo;huile v&eacute;g&eacute;tale</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c5">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer le poisson</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Nettoyer soigneusement le poisson.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire quelques incisions sur les c&ocirc;t&eacute;s.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Saler l&eacute;g&egrave;rement et r&eacute;server.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la sauce</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Mixer les tomates, l&rsquo;oignon et l&rsquo;ail.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter les &eacute;pices Mbongo Tchobi.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer jusqu&rsquo;&agrave; obtenir une p&acirc;te homog&egrave;ne.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Cuisson</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;D&eacute;poser le poisson dans une marmite.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Verser la pr&eacute;paration sur le poisson.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter un peu d&rsquo;eau et l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laisser cuire &agrave; feu moyen pendant environ 40 minutes.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Finalisation</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;V&eacute;rifier la cuisson du poisson.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajuster le sel et le poivre.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Servir chaud.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Accompagnements recommand&eacute;s</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;B&acirc;ton de manioc (bobolo)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Miondo</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Plantain bouilli</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Riz blanc</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><hr style="page-break-before:always;display:none;"><p class="c17 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c12"><span class="c26">KOKI</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 308.00px; height: 311.50px;"><img alt="" src="images/image4.jpg" style="width: 308.00px; height: 311.50px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Le koki est une sp&eacute;cialit&eacute; camerounaise pr&eacute;par&eacute;e &agrave; partir de haricots blancs d&eacute;cortiqu&eacute;s et d&rsquo;huile de palme. Tr&egrave;s nourrissant, il est souvent servi avec des bananes plantains m&ucirc;res ou du manioc. Son go&ucirc;t doux et sa texture moelleuse en font un plat appr&eacute;ci&eacute; de toute la famille.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c7">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">&#9201;&#65039; 2 h</span></p><p class="c1"><span class="c4">Pour&#128101; 4 &agrave; 6 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de haricots blancs d&eacute;cortiqu&eacute;s</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;250 ml d&rsquo;huile de palme rouge</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel selon le go&ucirc;t</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Feuilles de bananier ou moules de cuisson</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer les haricots</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Tremper les haricots plusieurs heures.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Retirer les peaux.</span></p><p class="c1"><span class="c4">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Rincer soigneusement.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la p&acirc;te</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c20">Mettre la p&acirc;te d&rsquo;haricot blanc ecrass&eacute; dans un bolle </span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter un peu d&rsquo;eau pour obtenir une p&acirc;te lisse.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer le sel </span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Ajouter l&rsquo;huile</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Verser progressivement l&rsquo;huile de palme tout en m&eacute;langeant afin d&rsquo;obtenir une p&acirc;te homog&egrave;ne.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Cuisson</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.</span><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;R&eacute;partir la pr&eacute;paration dans les feuilles de bananier ou dans des moules.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Cuire &agrave; la vapeur pendant environ 1 h 30.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 5 : Servir</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c20">Laisser ti&eacute;dir avant de d&eacute;guster.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Accompagnements recommand&eacute;s</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Bananes plantains m&ucirc;res bouillies</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Manioc bouilli</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Patates douces</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c2"></span></p><hr style="page-break-before:always;display:none;"><p class="c12 c3"><span class="c15"></span></p><p class="c12"><span class="c26">POULET DG</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 289.81px; height: 289.81px;"><img alt="" src="images/image10.jpg" style="width: 289.81px; height: 289.81px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Le Poulet DG, qui signifie &laquo; Directeur G&eacute;n&eacute;ral &raquo;, est un plat raffin&eacute; de la cuisine camerounaise. Il associe du poulet tendre, des plantains m&ucirc;rs frits et des l&eacute;gumes color&eacute;s. Aujourd&rsquo;hui, il est servi aussi bien lors des f&ecirc;tes familiales que dans les restaurants.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c7">&#9201;&#65039;</span><span class="c4">&nbsp;1 h 15 min</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Pour&#128101; 4 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1</span><span class="c4">&nbsp;poulet d&eacute;coup&eacute; en morceaux</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 plantains m&ucirc;rs</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 carottes</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 poivron vert</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 poivron rouge</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 tomates</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 gousses d&rsquo;ail</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 cuill&egrave;res &agrave; soupe d&rsquo;huile</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 cube d&rsquo;assaisonnement</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Assaisonner le poulet</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Laver et assaisonner les morceaux de poulet.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter l&rsquo;ail, le sel, le poivre et l&rsquo;oignon.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laisser mariner 30 minutes.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Cuire le poulet</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Faire cuire le poulet puis le faire l&eacute;g&egrave;rement dorer dans un peu d&rsquo;huile.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Pr&eacute;parer les plantains</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1</span><span class="c4">.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&Eacute;plucher les plantains.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les couper en rondelles ou en b&acirc;tonnets.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les frire jusqu&rsquo;&agrave; obtenir une belle couleur dor&eacute;e.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Pr&eacute;parer les l&eacute;gumes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Faire revenir les carottes, les poivrons et les tomates dans une po&ecirc;le.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 5 : Assemblage</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Ajouter le poulet aux l&eacute;gumes puis incorporer les plantains frits. M&eacute;langer d&eacute;licatement et laisser mijoter quelques minutes.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;sentation</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Servir chaud dans un grand plat afin de mettre en valeur les couleurs des l&eacute;gumes et des plantains.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c17 c3"><span class="c25 c35"></span></p><p class="c17"><span class="c25">Astuce T&eacute;claire Writes</span><hr style="page-break-before:always;display:none;"></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span class="c35 c42">SAUCE PISTACHE ET COUSCOUS DE MANIOC</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 265.50px; height: 283.94px;"><img alt="" src="images/image1.jpg" style="width: 265.50px; height: 283.94px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">La sauce pistache est un mets traditionnel tr&egrave;s appr&eacute;ci&eacute; au Cameroun. Pr&eacute;par&eacute;e &agrave; partir de graines de courge moulues, elle offre une texture riche et un go&ucirc;t d&eacute;licat. Accompagn&eacute;e de couscous de manioc, elle constitue un repas nourrissant et convivial, souvent servi lors des r&eacute;unions familiales.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c7">&#9201;&#65039; </span><span class="c4">1 h 30 min</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Pour &#128101; 4 &agrave; 6 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pour la sauce pistache</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de graines de courge (pistache) moulues</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;300 g de viande de b&oelig;uf ou de poisson fum&eacute;</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 g de crevettes fra&icirc;ches ou s&eacute;ch&eacute;es</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 gousses d&rsquo;ail</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 piment (facultatif)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pour le couscous de manioc</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de farine de manioc</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer la sauce</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">M&eacute;langer la pistache moulue avec un peu d&rsquo;eau pour former une p&acirc;te.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter l&rsquo;oignon et l&rsquo;ail &eacute;cras&eacute;s.</span></p><p class="c1"><span class="c20">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer la viande ou le poisson</span><span class="c2">.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Cuisson</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">D&eacute;poser la pr&eacute;paration dans une marmite.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter les crevettes.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laisser cuire &agrave; feu moyen pendant environ 45 minutes.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le sel et le piment selon le go&ucirc;t.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Pr&eacute;parer le couscous de manioc</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Faire chauffer de l&rsquo;eau.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Verser progressivement la farine de manioc.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Remuer continuellement jusqu&rsquo;&agrave; obtenir une p&acirc;te souple et homog&egrave;ne</span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c3 c17"><span class="c6"></span></p><hr style="page-break-before:always;display:none;"><p class="c12 c3"><span class="c18"></span></p><p class="c12"><span class="c18">OKOK</span></p><p class="c12 c3"><span class="c18"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 285.16px; height: 303.34px;"><img alt="" src="images/image12.jpg" style="width: 285.16px; height: 303.34px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1"><span class="c4">L&rsquo;Okok est un plat traditionnel des peuples B&euml;ti du Centre et du Sud du Cameroun. Pr&eacute;par&eacute; &agrave; base de feuilles d&rsquo;okok finement &eacute;cras&eacute;es et de p&acirc;te d&rsquo;arachide, ce mets est appr&eacute;ci&eacute; pour son go&ucirc;t riche et sa valeur nutritive. Il est souvent servi lors des c&eacute;r&eacute;monies et des repas familiaux.</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1"><span class="c7">&#9201;&#65039; </span><span class="c4">1 h 30 min</span></p><p class="c1"><span class="c4">Pour&#128101; 4 &agrave; 6 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de feuilles d&rsquo;okok finement hach&eacute;es</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;300 g de p&acirc;te d&rsquo;arachide</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 g de poisson fum&eacute; ou de viande</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;150 g de crevettes s&eacute;ch&eacute;es ou fra&icirc;ches</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 ml d&rsquo;huile de palme</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel et cube selon le go&ucirc;t</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer les feuilles</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Laver soigneusement les feuilles d&rsquo;okok.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les melanger avec de l&rsquo;huile dans une marmite jusqu&rsquo;a obtenir un melange homog&egrave;ne</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la base</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Faire cuire le poisson fum&eacute; et la viande.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Ajouter les arachides</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Incorporer la p&acirc;te d&rsquo;arachide aux feuilles d&rsquo;okok </span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter un peu d&rsquo;eau pour faciliter le m&eacute;lange.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Remuer jusqu&rsquo;&agrave; obtenir une pr&eacute;paration homog&egrave;ne.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer soigneusement.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 5 : Finalisation</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Ajouter les crevettes et l&rsquo;huile de palme.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laisser mijoter &agrave; feu doux pendant environ 30 minutes.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajuster le sel selon votre go&ucirc;t.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Accompagnements recommand&eacute;s</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">B&acirc;ton de manioc (bobolo)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Manioc bouilli</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Plantain m&ucirc;r bouilli</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes </span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c2"></span></p><hr style="page-break-before:always;display:none;"><p class="c1 c3"><span class="c15"></span></p><p class="c12"><span class="c15">COUSCOUS DE MA&Iuml;S ET L&Eacute;GUMES</span></p><p class="c1 c3"><span class="c15"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 278.00px; height: 309.82px;"><img alt="" src="images/image16.jpg" style="width: 278.00px; height: 309.82px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Le couscous de ma&iuml;s est tr&egrave;s appr&eacute;ci&eacute; dans les r&eacute;gions septentrionales du Cameroun. L&eacute;ger, nourrissant et facile &agrave; pr&eacute;parer, il accompagne parfaitement les sauces aux l&eacute;gumes, &agrave; la viande, au poulet ou au poisson. Ce plat simple est souvent partag&eacute; en famille et lors des grandes occasions.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c7">&#9201;&#65039; 1 </span><span class="c4">h</span></p><p class="c1"><span class="c4">Pour&#128101; 4 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pour le couscous</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de farine de ma&iuml;s</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Une pinc&eacute;e de sel</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pour les l&eacute;gumes</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">2 carottes</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 chou moyen</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 poivron vert</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 tomates</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;300 g de viande ou de poisson</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3 cuill&egrave;res &agrave; soupe d&rsquo;huile</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer le couscous</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Humidifier l&eacute;g&egrave;rement la farine de ma&iuml;s.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;La travailler avec les mains pour former de petits grains.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Cuire &agrave; la vapeur pendant environ 30 minutes.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer les l&eacute;gumes</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Laver et d&eacute;couper tous les l&eacute;gumes puis les bouillir</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire revenir l&rsquo;oignon dans l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter les tomates puis les autres l&eacute;gumes.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer la viande ou le poisson d&eacute;j&agrave; cuit.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Assaisonner et laisser mijoter.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><hr style="page-break-before:always;display:none;"><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span class="c15">&nbsp;FRITES DE PLANTAIN M&Ucirc;R ET HARICOTS ROUGES</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 266.00px; height: 278.50px;"><img alt="" src="images/image9.jpg" style="width: 266.00px; height: 278.50px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Le plantain m&ucirc;r et les haricots rouges forment une association incontournable de la cuisine camerounaise. Ce repas &eacute;quilibr&eacute; est appr&eacute;ci&eacute; pour son go&ucirc;t l&eacute;g&egrave;rement sucr&eacute; et sa richesse en prot&eacute;ines v&eacute;g&eacute;tales. Facile &agrave; pr&eacute;parer, il convient parfaitement aux familles et aux &eacute;tudiants.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c7">&#9201;&#65039; </span><span class="c4">1 h 15 min</span></p><p class="c1"><span class="c4">Pour&#128101; 4 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">4 plantains m&ucirc;rs</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500 g de haricots rouges</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 gros oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 tomates</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3 cuill&egrave;res &agrave; soupe d&rsquo;huile v&eacute;g&eacute;tale</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 cube d&rsquo;assaisonnement (facultatif)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel selon le go&ucirc;t</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer les haricots</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Trier et laver les haricots rouges.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les faire tremper quelques heures si possible.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les cuire dans de l&rsquo;eau jusqu&rsquo;&agrave; ce qu&rsquo;ils deviennent tendres.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la sauce</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">&Eacute;mincer l&rsquo;oignon et couper les tomates en petits d&eacute;s.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire revenir l&rsquo;oignon dans l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter les tomates et laisser cuire quelques minutes.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer les haricots cuits.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le sel et l&rsquo;assaisonnement selon votre go&ucirc;t.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Pr&eacute;parer les plantains</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">&Eacute;plucher les plantains m&ucirc;rs.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les couper selon la forme qui vous convient</span></p><p class="c1"><span class="c20">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire frire dans de l&rsquo;huile bien chaude</span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17 c3"><span class="c6"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes</span></p><hr style="page-break-before:always;display:none;"><p class="c17 c3"><span class="c2"></span></p><p class="c12"><span class="c8">POISSON BRAIS&Eacute; </span></p><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 281.50px; height: 305.42px;"><img alt="" src="images/image5.jpg" style="width: 281.50px; height: 305.42px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Le poisson brais&eacute; est l&rsquo;un des plats les plus populaires du Cameroun. Pr&eacute;par&eacute; avec des &eacute;pices parfum&eacute;es et grill&eacute; &agrave; la perfection, il est souvent servi dans les restaurants, les maquis et lors des r&eacute;unions familiales. Son go&ucirc;t fum&eacute; et relev&eacute; en fait un incontournable de la gastronomie camerounaise.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c7">&#9201;&#65039; </span><span class="c4">1 h 20 min</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Pour&#128101; 4 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;</span><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 poissons entiers (tilapia, capitaine ou maquereau)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 oignons</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3 tomates</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 gousses d&rsquo;ail</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 petit morceau de gingembre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 piment (facultatif)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 cuill&egrave;res &agrave; soupe d&rsquo;huile v&eacute;g&eacute;tale</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer le poisson</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Nettoyer soigneusement les poissons.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire quelques entailles sur les c&ocirc;t&eacute;s.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Saler l&eacute;g&egrave;rement.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la marinade</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Mixer les oignons, les tomates, l&rsquo;ail, le gingembre et le piment.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le sel, le poivre et l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Bien m&eacute;langer.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Mariner</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Badigeonner g&eacute;n&eacute;reusement les poissons avec la marinade et laisser reposer 30 minutes.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Cuisson</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Faire griller les poissons au barbecue, au four ou sur une grille jusqu&rsquo;&agrave; ce qu&rsquo;ils soient bien dor&eacute;s.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Accompagnements recommand&eacute;s</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">B&acirc;ton de manioc (bobolo)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Plantains brais&eacute;s</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Miondo</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><hr style="page-break-before:always;display:none;"><p class="c12 c3"><span class="c15"></span></p><p class="c12"><span class="c15">JOLLOF RICE AU POULET</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 310.50px; height: 257.00px;"><img alt="" src="images/image2.jpg" style="width: 340.55px; height: 289.65px; margin-left: -30.05px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Le Jollof Rice est un plat de riz parfum&eacute; cuit dans une sauce tomate &eacute;pic&eacute;e. Tr&egrave;s populaire en Afrique de l&rsquo;Ouest, il est souvent pr&eacute;par&eacute; lors des f&ecirc;tes, anniversaires et repas de famille. Sa couleur rouge-orang&eacute;e et son go&ucirc;t savoureux en font un incontournable.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">&#9201;&#65039; 1 h 15 min</span></p><p class="c1"><span class="c4">Pour&#128101; 4 &agrave; 6 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">500 g de riz long grain</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 poulet d&eacute;coup&eacute; en morceaux</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 tomates fra&icirc;ches</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 bo&icirc;te de concentr&eacute; de tomate</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 oignons</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 poivron rouge</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 gousses d&rsquo;ail</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 petit morceau de gingembre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 cuill&egrave;res &agrave; soupe d&rsquo;huile v&eacute;g&eacute;tale</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 cube d&rsquo;assaisonnement</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 litre d&rsquo;eau ou de bouillon</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer le poulet</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Assaisonner le poulet avec le sel, l&rsquo;ail, le gingembre et le poivre.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Le faire cuire puis le r&eacute;server.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la sauce</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Mixer les tomates, les oignons, le poivron, l&rsquo;ail et le gingembre.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire revenir le m&eacute;lange dans l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le concentr&eacute; de tomate.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laisser cuire environ 15 minutes.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Cuire le riz</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Laver le riz.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le riz &agrave; la sauce.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Verser le bouillon chaud.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Couvrir et laisser cuire &agrave; feu doux jusqu&rsquo;&agrave; absorption compl&egrave;te du liquide.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Finalisation</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Ajouter les morceaux de poulet.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer d&eacute;licatement.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laisser reposer quelques minutes avant de servir.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Accompagnements recommand&eacute;s</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Salade de l&eacute;gumes frais</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Bananes plantains frites</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poulet grill&eacute;</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><hr style="page-break-before:always;display:none;"><p class="c17 c3"><span class="c6"></span></p><p class="c12"><span class="c8">TARO ET SAUCE JAUNE</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 280.50px; height: 302.00px;"><img alt="" src="images/image11.jpg" style="width: 280.50px; height: 302.00px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c12 c3"><span class="c6"></span></p><p class="c12 c3"><span class="c6"></span></p><p class="c12 c3"><span class="c6"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Le taro &agrave; la sauce jaune est l&rsquo;un des plats les plus embl&eacute;matiques de l&rsquo;Ouest et du Nord-Ouest du Cameroun. Tr&egrave;s pr&eacute;sent lors des mariages, fun&eacute;railles et c&eacute;r&eacute;monies traditionnelles, il est appr&eacute;ci&eacute; pour sa sauce onctueuse &agrave; base d&rsquo;huile de palme et de pierre de potasse. C&rsquo;est un plat convivial qui occupe une place importante dans la culture camerounaise.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">&#9201;&#65039; 2 heures</span></p><p class="c1"><span class="c4">Pour&#128101; 6 personnes</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Pour le taro</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 kg de taro</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Pour la sauce jaune</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500 ml d&rsquo;huile de palme rouge</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;300 g de viande de b&oelig;uf</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 g de peau de b&oelig;uf (kanda) facultatif</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 litres d&rsquo;eau</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 morceau de pierre de potasse (kanwa)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel selon le go&ucirc;t</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Cuire le taro</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laver soigneusement les tubercules de taro.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les cuire avec leur peau dans de l&rsquo;eau sal&eacute;e.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Une fois cuits, les &eacute;plucher puis les piler </span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer la viande</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire cuire la viande et le kanda avec un peu de sel.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Conserver le bouillon de cuisson.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Pr&eacute;parer la sauce jaune</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Dissoudre la pierre de potasse dans un peu d&rsquo;eau.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Filtrer la solution obtenue.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Verser progressivement l&rsquo;huile de palme dans une bassine.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter doucement la solution de potasse tout en remuant.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;5.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;La sauce prendra progressivement une couleur jaune-orang&eacute;e et une texture cr&eacute;meuse.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Finalisation</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le bouillon de viande.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer la viande cuite.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajuster le sel.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer d&eacute;licatement jusqu&rsquo;&agrave; obtenir une sauce homog&egrave;ne.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c7">Pr&eacute;sentation</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Servir le taro chaud accompagn&eacute; de la sauce jaune dans un plat de service.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c29"></span></p><hr style="page-break-before:always;display:none;"><p class="c12 c3"><span class="c8"></span></p><p class="c12"><span class="c8">PIL&Eacute; DE POMMES DE TERRE</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 252.50px; height: 277.54px;"><img alt="" src="images/image6.jpg" style="width: 252.50px; height: 277.54px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Le pil&eacute; de pommes de terre est un plat traditionnel de l&rsquo;Ouest Cameroun. Tr&egrave;s appr&eacute;ci&eacute; pour sa simplicit&eacute; et son go&ucirc;t authentique, il associe des pommes de terre tendres &agrave; de l&rsquo;haricot noir &nbsp;et &agrave; l&rsquo;huile de palme. C&rsquo;est un repas nourrissant qui se partage souvent en famille.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">&#9201;&#65039; 1 heure</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Pour&#128101; 4 personnes</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 kg de pommes de terre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;300 d&rsquo;haricots noirs</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 gros oignon </span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;150 ml d&rsquo;huile de palme rouge</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel selon le go&ucirc;t</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 piment (facultatif)</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer les pommes de terre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&Eacute;plucher et laver les pommes de terre.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les couper en morceaux.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les faire cuire dans de l&rsquo;eau sal&eacute;e jusqu&rsquo;&agrave; ce qu&rsquo;elles soient tendres.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer les haricots</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laver soigneusement </span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les faire cuire avec du sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Puis reserver</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : R&eacute;aliser le pil&eacute;</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&Eacute;goutter les pommes de terre et les haricots</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les piler ou les &eacute;craser encore chaudes.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer l&rsquo;huile de palme tout en m&eacute;langeant.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Finalisation</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le sel et le piment selon votre go&ucirc;t.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer jusqu&rsquo;&agrave; obtenir une texture homog&egrave;ne.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Servir chaud.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c13"></span></p><hr style="page-break-before:always;display:none;"><p class="c12 c3"><span class="c8"></span></p><p class="c12"><span class="c8">SPAGHETTIS SAUT&Eacute;S </span></p><p class="c1 c3"><span class="c13"></span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 350.11px; height: 271.03px;"><img alt="" src="images/image8.jpg" style="width: 350.11px; height: 271.03px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c13"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c13"></span></p><p class="c1"><span class="c4">Les spaghettis saut&eacute;s &agrave; la camerounaise sont un repas rapide et savoureux, tr&egrave;s populaire dans les familles et chez les &eacute;tudiants. Pr&eacute;par&eacute;s avec des l&eacute;gumes frais et parfois de la viande ou du poisson, ils constituent un plat complet et color&eacute;.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">&#9201;&#65039; 45 min</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c4">Pour 4 personnes</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500 g de spaghettis</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 carottes</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 poivron vert</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 oignon</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 tomates</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;200 g de viande ou de saucisses (facultatif)</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3 cuill&egrave;res &agrave; soupe d&rsquo;huile v&eacute;g&eacute;tale</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 cube d&rsquo;assaisonnement</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Cuire les spaghettis</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire bouillir de l&rsquo;eau sal&eacute;e.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter les spaghettis.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Cuire selon les indications du paquet.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&Eacute;goutter et r&eacute;server.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer les l&eacute;gumes</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Couper les carottes, le poivron, l&rsquo;oignon et les tomates.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire revenir l&rsquo;oignon dans l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter les autres l&eacute;gumes et laisser cuire quelques minutes.</span></p><p class="c1 c3"><span class="c4"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Assemblage</span></p><p class="c1"><span class="c27">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter la viande ou les saucisses si utilis&eacute;es.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer les spaghettis cuits.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;M&eacute;langer soigneusement.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Assaisonner avec le sel, le poivre et le cube</span></p><p class="c1 c3"><span class="c20 c31"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c6"></span></p><p class="c1 c3"><span class="c6"></span></p><p class="c12 c3"><span class="c8"></span></p><p class="c12 c3"><span class="c8"></span></p><p class="c12 c3"><span class="c8"></span></p><p class="c12"><span class="c34">KONDRE</span></p><p class="c12"><span style="overflow: hidden; display: inline-block; margin: 0.00px 0.00px; border: 0.00px solid #000000; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px); width: 258.50px; height: 278.84px;"><img alt="" src="images/image15.jpg" style="width: 258.50px; height: 278.84px; margin-left: 0.00px; margin-top: 0.00px; transform: rotate(0.00rad) translateZ(0px); -webkit-transform: rotate(0.00rad) translateZ(0px);" title=""></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Description</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c4">Le kondr&egrave; est un plat traditionnel originaire de l&rsquo;Ouest Cameroun. Pr&eacute;par&eacute; &agrave; base de plantains non m&ucirc;rs et de viande, il est appr&eacute;ci&eacute; pour sa sauce riche et parfum&eacute;e. Tr&egrave;s nourrissant, il est souvent servi lors des repas de famille et des c&eacute;r&eacute;monies.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Temps de pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&#9201;&#65039; 2 heures</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c20">Pour&#128101; 6 personnes</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Ingr&eacute;dients</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">6 plantains verts</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;500 g de viande de b&oelig;uf ou de ch&egrave;vre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 oignons</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3 tomates</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2 gousses d&rsquo;ail</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 morceau de gingembre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;4 cuill&egrave;res &agrave; soupe d&rsquo;huile v&eacute;g&eacute;tale</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1 cube d&rsquo;assaisonnement</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Sel</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Poivre</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&bull;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Eau</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">Pr&eacute;paration</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 1 : Pr&eacute;parer la viande</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Laver et d&eacute;couper la viande.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Assaisonner avec l&rsquo;ail, le gingembre, le sel et le poivre.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire cuire jusqu&rsquo;&agrave; ce qu&rsquo;elle soit tendre.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 2 : Pr&eacute;parer les plantains</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">&Eacute;plucher les plantains verts.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les couper en gros morceaux.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Les laver soigneusement.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 3 : Pr&eacute;parer la sauce</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="c4">Mixer les tomates et les oignons.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Faire revenir le m&eacute;lange dans l&rsquo;huile.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter le bouillon de viande.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1"><span class="c2">&Eacute;tape 4 : Cuisson du kondr&egrave;</span></p><p class="c1"><span class="c7">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;1.</span><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Ajouter les morceaux de plantain dans la sauce.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;2.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Incorporer la viande.</span></p><p class="c1"><span class="c4">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;3.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Laisser cuire &agrave; feu moyen jusqu&rsquo;&agrave; ce que les plantains deviennent tendres et que la sauce &eacute;paississe.</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><p class="c17"><span class="c6">Astuce T&eacute;claire Writes &#10024;</span></p><p class="c1 c3"><span class="c2"></span></p><p class="c1 c3"><span class="c2"></span></p><div><p class="c1 c3"><span class="c28"></span></p></div></body></html>